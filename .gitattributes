# Keep shell scripts LF on every OS (CRLF breaks bash on Windows checkouts).
*.sh        text eol=lf
# Source and text assets: normalise line endings in the repository.
*.cs        text
*.md        text
*.json      text
*.asmdef    text
*.uxml      text
*.uss       text
*.tss       text
*.shader    text
# Unity YAML generated by the Editor: keep LF, never auto-convert.
*.unity     text eol=lf
*.meta      text eol=lf
*.mat       text eol=lf
*.asset     text eol=lf
*.prefab    text eol=lf
